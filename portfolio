def retry_github(
    sender=None,
    app_data=None,
    user_data=None,
):

    global loading
    global load_error
    global profile_loaded
    global repositories_loaded

    with data_lock:

        loading = True
        load_error = ""

    profile_loaded = False
    repositories_loaded = False

    if dpg.does_item_exist(
        "error_window"
    ):
        dpg.hide_item(
            "error_window"
        )

    if dpg.does_item_exist(
        "loading_window"
    ):
        dpg.show_item(
            "loading_window"
        )

    thread = threading.Thread(
        target=load_github_data,
        daemon=True,
    )

    thread.start()


def refresh_ui():

    global profile_loaded
    global repositories_loaded

    with data_lock:

        current_loading = loading
        current_error = load_error
        user_available = github_user is not None

    if (
        not current_loading
        and user_available
        and not profile_loaded
    ):

        if dpg.does_item_exist(
            "loading_window"
        ):
            dpg.hide_item(
                "loading_window"
            )

        if dpg.does_item_exist(
            "profile_container"
        ):

            dpg.delete_item(
                "profile_container",
                children_only=True,
            )

            build_profile(
                "profile_container"
            )

        profile_loaded = True

    if (
        not current_loading
        and user_available
        and not repositories_loaded
    ):

        if dpg.does_item_exist(
            "repo_loading_text"
        ):
            dpg.hide_item(
                "repo_loading_text"
            )

        rebuild_repositories()

        repositories_loaded = True

    if (
        not current_loading
        and current_error
    ):

        if dpg.does_item_exist(
            "loading_window"
        ):
            dpg.hide_item(
                "loading_window"
            )

        if dpg.does_item_exist(
            "error_text"
        ):
            dpg.set_value(
                "error_text",
                current_error,
            )

        if dpg.does_item_exist(
            "error_window"
        ):
            dpg.show_item(
                "error_window"
            )


def center_window(tag, width, height):

    try:

        viewport_width = dpg.get_viewport_width()
        viewport_height = dpg.get_viewport_height()

        x = max(
            0,
            int(
                (viewport_width - width) / 2
            ),
        )

        y = max(
            0,
            int(
                (viewport_height - height) / 2
            ),
        )

        dpg.set_item_pos(
            tag,
            [x, y],
        )

    except Exception:
        pass


def main():

    dpg.create_context()

    setup_theme()

    fonts = ensure_fonts()

    dpg.create_viewport(
        title=APP_TITLE,
        width=1200,
        height=850,
        min_width=850,
        min_height=600,
        resizable=True,
        decorated=False,
    )

    build_app()

    build_loading_window()

    build_error_window()

    if fonts.get("default"):
        dpg.bind_font(
            fonts["default"]
        )

    dpg.setup_dearpygui()

    dpg.show_viewport()

    dpg.set_primary_window(
        "main_window",
        True,
    )

    center_window(
        "loading_window",
        420,
        180,
    )

    center_window(
        "error_window",
        600,
        230,
    )

    thread = threading.Thread(
        target=load_github_data,
        daemon=True,
    )

    thread.start()

    while dpg.is_dearpygui_running():

        refresh_ui()

        dpg.render_dearpygui_frame()

    dpg.destroy_context()


if __name__ == "__main__":
    main()
