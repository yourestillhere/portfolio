def get_filtered_repositories():

    if not repo_search.strip():
        return github_repos

    query = repo_search.lower().strip()

    results = []

    for repo in github_repos:

        name = (
            repo.get("name") or ""
        ).lower()

        description = (
            repo.get("description") or ""
        ).lower()

        language = (
            repo.get("language") or ""
        ).lower()

        if (
            query in name
            or query in description
            or query in language
        ):
            results.append(repo)

    return results


def rebuild_repositories():

    if not dpg.does_item_exist(
        "repo_container"
    ):
        return

    dpg.delete_item(
        "repo_container",
        children_only=True,
    )

    repositories = get_filtered_repositories()

    if not repositories:

        dpg.add_text(
            "No repositories found.",
            color=TEXT_DIM,
            parent="repo_container",
        )

        return

    for index, repo in enumerate(repositories):

        build_repo_card(
            repo,
            "repo_container",
        )

        if index < len(repositories) - 1:

            dpg.add_separator(
                parent="repo_container",
            )

            dpg.add_spacer(
                height=10,
                parent="repo_container",
            )


