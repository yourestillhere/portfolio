def open_url(url):
    if not url:
        return

    try:
        webbrowser.open_new_tab(url)
    except Exception as exc:
        print(f"Could not open link: {exc}")


def copy_to_clipboard(text):
    try:
        import tkinter as tk

        root = tk.Tk()
        root.withdraw()

        root.clipboard_clear()
        root.clipboard_append(text)

        root.update()
        root.destroy()

        if dpg.does_item_exist("email_status"):
            dpg.set_value(
                "email_status",
                f"Copied {text} to clipboard",
            )

    except Exception as exc:
        print(f"Could not copy to clipboard: {exc}")


def link_callback(sender, app_data, user_data):
    if not user_data:
        return

    if isinstance(user_data, str) and user_data.startswith("email:"):
        copy_to_clipboard(user_data[6:])
        return

    open_url(user_data)


def format_date(value):
    if not value:
        return "Unknown"

    try:
        date = datetime.fromisoformat(
            value.replace("Z", "+00:00")
        )

        return date.strftime("%b %d, %Y")

    except Exception:
        return str(value)[:10]


def truncate(text, length=155):
    if not text:
        return "No description provided."

    text = str(text)
    text = text.replace("\n", " ")
    text = text.strip()

    if len(text) <= length:
        return text

    return text[:length - 3] + "..."


def github_request(url):
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": "yourestillhere-portfolio",
        "X-GitHub-Api-Version": "2022-11-28",
    }

    response = requests.get(
        url,
        headers=headers,
        timeout=15,
    )

    response.raise_for_status()

    return response.json()


def load_github_data():
    global github_user
    global github_repos
    global avatar_pixels
    global avatar_width
    global avatar_height
    global loading
    global load_error

    try:
        user = github_request(
            f"{GITHUB_API}/users/{GITHUB_USERNAME}"
        )

        repos = github_request(
            f"{GITHUB_API}/users/{GITHUB_USERNAME}/repos"
            "?type=owner&sort=updated&direction=desc&per_page=100"
        )

        public_repos = [
            repo
            for repo in repos
            if not repo.get("private", False)
        ]

        new_pixels = None
        new_width = 0
        new_height = 0

        avatar_url = user.get("avatar_url")

        if avatar_url:

            try:
                response = requests.get(
                    avatar_url,
                    headers={
                        "User-Agent": "yourestillhere-portfolio"
                    },
                    timeout=15,
                )

                response.raise_for_status()

                image = Image.open(
                    io.BytesIO(response.content)
                ).convert("RGBA")

                image.thumbnail((256, 256))

                new_width = image.width
                new_height = image.height
                new_pixels = list(image.getdata())

            except Exception as exc:
                print(f"Avatar error: {exc}")

        with data_lock:
            github_user = user
            github_repos = public_repos

            avatar_pixels = new_pixels
            avatar_width = new_width
            avatar_height = new_height

            loading = False
            load_error = ""

    except Exception as exc:

        with data_lock:
            loading = False
            load_error = str(exc)


