def create_avatar_texture():

    if not avatar_pixels:
        return None

    if dpg.does_item_exist("avatar_texture"):
        dpg.delete_item("avatar_texture")

    values = []

    for pixel in avatar_pixels:

        values.append(pixel[0] / 255.0)
        values.append(pixel[1] / 255.0)
        values.append(pixel[2] / 255.0)
        values.append(pixel[3] / 255.0)

    with dpg.texture_registry():

        dpg.add_dynamic_texture(
            width=avatar_width,
            height=avatar_height,
            default_value=values,
            tag="avatar_texture",
        )

    return "avatar_texture"


